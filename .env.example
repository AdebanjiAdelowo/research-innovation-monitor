# All variables are optional. The reported experiments need none of them.

# Hugging Face token, only for higher download rate limits.
HF_TOKEN=

# OpenAlex key, only for the optional citation-count enrichment.
OPENALEX_API_KEY=

# Local generation backend (Ollama).
RIM_OLLAMA_URL=http://localhost:11434
RIM_OLLAMA_MODEL=llama3.2

# Where datasets, embeddings and indices are stored.
RIM_DATA_DIR=data

# Set by the Kaggle runner when the code is not a git checkout.
RIM_GIT_COMMIT=

# Set to 1 on networks where IPv6 is advertised but does not work (downloads hang).
RIM_FORCE_IPV4=
